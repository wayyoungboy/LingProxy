# LingProxy Docker config (SQLite, no extra database container required)

app:
  name: "LingProxy"
  version: "1.0.0"
  environment: "production"
  port: 8080
  host: "0.0.0.0"

storage:
  type: "gorm"
  gorm:
    driver: "sqlite"
    dsn: "./data/lingproxy.db"

log:
  level: "info"
  format: "json"
  output: "both"
  file_path: "./logs/lingproxy.log"
  max_size: 100
  max_backups: 3
  max_age: 28
  compress: true

security:
  auth:
    enabled: true
  cors:
    enabled: true
    allow_origins:
      - "*"
    allow_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
      - "OPTIONS"
    allow_headers:
      - "*"

load_balancer:
  default_strategy: "round_robin"

provider:
  timeout: "30s"
  max_retries: 3
