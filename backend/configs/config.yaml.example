# LingProxy example config
# Copy to config.yaml if you want a local override:
#   cp configs/config.yaml.example configs/config.yaml
#
# A fresh clone can boot with this file as-is (no extra database, no provider keys).
# Admin login after first start: username=admin  password=admin123
# Change the password in the admin UI after login.
#
# LLM provider API keys are NOT stored here. Add them in Admin UI → LLM Resources
# using placeholders such as sk-your-openai-key (never commit real keys).

app:
  environment: "development"  # development, staging, production
  port: 8080
  host: "0.0.0.0"

storage:
  type: "gorm"  # memory or gorm
  gorm:
    # SQLite works out of the box (pure Go, no extra service).
    driver: "sqlite"  # sqlite, mysql, seekdb
    dsn: "lingproxy.db"

    # MySQL example (optional)
    # driver: "mysql"
    # dsn: "root:YOUR_DB_PASSWORD@tcp(localhost:3306)/lingproxy?charset=utf8mb4&parseTime=True&loc=Local"

    # SeekDB / OceanBase example (optional; requires a running SeekDB)
    # driver: "seekdb"
    # dsn: "root:@tcp(localhost:2881)/lingproxy?charset=utf8mb4&parseTime=True&loc=Local"

log:
  level: "info"  # debug, info, warn, error, fatal
  format: "json"  # text, json
  output: "both"  # stdout, file, both
  file_path: "./logs/lingproxy.log"

security:
  auth:
    enabled: true  # false = APIs except login skip authentication
